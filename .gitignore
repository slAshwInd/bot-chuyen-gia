# Deny-by-default. SOURCE_ALLOWLIST.txt + source_guard.py are authoritative too.
/*
!/.gitignore
!/*.py
!/*.ps1
!/*.bat
!/*.md
!/requirements.txt
!/VERSION.txt
!/MANIFEST_BaseAster_1.2.txt
!/SHA256_BaseAster_1.2.txt
!/SOURCE_ALLOWLIST.txt
!/monitor_config.example.json
!/ref/
/ref/*
!/ref/config_paper.json
!/tests/
/tests/*
!/tests/*.py
!/tests/fixture_ei_sample.json
!/tests/fixture_x10_config_live.json
# Never stage local helpers or any credentials/runtime/account data.
/_*.py
/_*.txt
/secrets/
/updates/
/upcode/
/config_live.json
/monitor_config.json
/state/
/logs/
/data/
/charts/
/.venv/
/__pycache__/
**/__pycache__/
*.env
*.key
*.pem
*.pfx
*.bak
*.orig*
*.tmp
*.log
*.pid
*.csv
*.jsonl
/ALLOW_PC_RUN.flag
/KILL
